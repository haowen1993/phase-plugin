{
  "name": "phase-rs-zh",
  "version": "1.9.2",
  "private": true,
  "type": "module",
  "description": "一个书签小工具：把 phase.rs 网页版的卡图换成大学院废墟（mtgch.com）的简体中文图，并把回合阶段图标换成公开图标库的图形。",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build-bookmarklet.mjs",
    "build:preview": "node tools/build-icon-preview.mjs",
    "test": "node --test test/content.test.mjs",
    "test:dom": "vitest run",
    "check:live": "node tools/check-live.mjs",
    "check:icons": "node tools/check-icon-fits.mjs",
    "check:crash": "node tools/check-crash-safety.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.0.0",
    "vitest": "^4.0.0"
  }
}
